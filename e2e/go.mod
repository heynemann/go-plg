// The rewards platform's end-to-end tests (`make complex-e2e`): a module of its own, like examples/, so plg's
// go.mod never gains their dependencies. It builds against this checkout of plg, of the examples (the S3 storage
// and the test helpers it shares with them) and of the rewards contracts.
module github.com/heynemann/go-plg/e2e

go 1.27

require (
	example.com/rewards v1.0.0
	github.com/aws/aws-sdk-go-v2 v1.47.5
	github.com/aws/aws-sdk-go-v2/service/s3 v1.114.6
